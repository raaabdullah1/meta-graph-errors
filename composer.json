{
    "name": "raaabdullah1/meta-graph-errors",
    "description": "Classify Meta Graph API, Instagram, Messenger and WhatsApp error codes into category, retryability and recovery action.",
    "type": "library",
    "license": "MIT",
    "keywords": ["meta", "facebook", "instagram", "whatsapp", "messenger", "graph-api", "errors", "retry"],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "MetaGraphErrors\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MetaGraphErrors\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
